rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to create and read competition registrations
    match /competition_registrations/{document} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if false;
    }

    // Allow users to read and write their own documents in portal_users
    match /portal_users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
    }
    
    // Allow users to create their own documents in portal_users
    match /portal_users/{userId} {
      allow create: if request.auth != null;
    }

    // Allow users to create, read, and update their own submissions in authorverseSummit
    // Document ID should match the user's UID for security
    match /authorverseSummit/{submissionId} {
      allow create: if request.auth != null && request.auth.uid == submissionId;
      allow read: if request.auth != null && request.auth.uid == submissionId;
      allow update: if request.auth != null && request.auth.uid == submissionId;
      allow delete: if false; // Prevent deletion of submissions
    }

    // Inkcultt Poetry Portal Collections
    
    // Allow users to read and write their own profile in inkcult_users
    match /inkcult_users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow users to create their own profile in inkcult_users
    match /inkcult_users/{userId} {
      allow create: if request.auth != null;
    }
    
    // Allow users to read and create their own submissions in inkcult_submissions
    match /inkcult_submissions/{submissionId} {
      allow read: if request.auth != null; // Allow reading all submissions for admin and voting
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null; // Allow updates for admin approval/rejection
      allow delete: if false; // Submissions cannot be deleted
    }
    
    // Allow all authenticated users to read active prompts
    match /inkcult_prompts/{promptId} {
      allow read: if request.auth != null;
      allow write: if false; // Only admins should be able to create prompts (handled separately)
    }
    
    // Allow users to create votes and read their own votes
    match /inkcult_votes/{voteId} {
      allow create: if true; // Anyone can create votes (device-based tracking)
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow update, delete: if false; // Votes cannot be modified once created
    }
    
    // Allow users to create batch votes and read their own batch votes
    match /inkcult_batch_votes/{batchVoteId} {
      allow create: if true; // Anyone can create batch votes (device-based tracking)
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow update, delete: if false; // Batch votes cannot be modified once created
    }
    
    // Allow vote count updates for authorverse submissions
    match /authorverse_vote_counts/{submissionId} {
      allow create, update: if true; // Anyone can update vote counts
      allow read: if true; // Anyone can read vote counts
      allow delete: if false; // Vote counts cannot be deleted
    }

    // Allow anyone to create a submission for the September Writing Competition
    match /submissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Indian Writers League (IWL) Submissions
    // Enabled for client-side reading for the Hall of Fame
    match /iwl_submissions/{submissionId} {
      allow read: if resource.data.selected == true;
      allow write: if false; 
    }
    
    // Allow reading from authorverseSummit collection for voting
    match /authorverseSummit/{submissionId} {
      allow read: if true; // Allow reading for voting system
      allow write: if false; // No writing allowed
    }
  }
}